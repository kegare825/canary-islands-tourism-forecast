# Datos
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Modelos entrenados
models/*.pkl
models/*.joblib
!models/.gitkeep

# Entornos y cachés
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Sistema
.DS_Store

# Figuras generadas
reports/figures/*
!reports/figures/.gitkeep

